@model List<JsonPost>
@{
    ViewData["Title"] = "Latest Posts";
}
<div class="mb-3"><a asp-action="Index" class="text-decoration-none">← Back to doctors</a></div>
<h1 class="h2 fw-bold">Posts from JSONPlaceholder</h1>
<p class="text-secondary">Posts are retrieved asynchronously from the public JSONPlaceholder API.</p>
@if (ViewBag.ErrorMessage is string error)
{
    <div class="alert alert-warning">@error</div>
}
<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th scope="col">Post ID</th><th scope="col">Title</th></tr></thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="2" class="text-center py-4 text-secondary">No posts to display.</td></tr>
            }
            else
            {
                @foreach (var post in Model)
                {
                    <tr><td class="fw-semibold">@post.Id</td><td>@post.Title</td></tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
